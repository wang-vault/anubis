# ============================================================================
# CONTOH KONFIGURASI — salin menjadi `.env.local` (dev) / Vercel env (prod)
# JANGAN PERNAH commit file .env asli. Nilai di bawah adalah PLACEHOLDER.
# ============================================================================
# Legenda:
#   [PUBLIC]  → diawali NEXT_PUBLIC_, ikut ke browser. TIDAK BOLEH rahasia.
#   [SERVER]  → hanya terbaca di server Vercel/Node.
#   [RAHASIA] → server-only + sensitif. Jangan pernah print / kirim ke client.
# ============================================================================

# --- Aplikasi ---------------------------------------------------------------
# [PUBLIC] URL publik situs (tanpa trailing slash). Dipakai link email & origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [PUBLIC] Nama toko yang tampil di header/title.
NEXT_PUBLIC_SITE_NAME=Toko Saya

# --- SUPABASE #1 (ACCOUNT: auth, verifikasi email, profil) ------------------
# Dapatkan: Dashboard Supabase #1 → Project Settings → Data API (or "API")
# [PUBLIC]
NEXT_PUBLIC_SUPABASE_ACCOUNT_URL=https://PROYEK-1.supabase.co
# [PUBLIC] anon/public key (aman untuk browser, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ACCOUNT_ANON_KEY=eyJhbGciOi...ANON_KEY_PROYEK_1
# [SERVER][RAHASIA] service_role — HANYA di server (bypass RLS). Jangan ke client.
SUPABASE_ACCOUNT_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_PROYEK_1

# --- SUPABASE #2 (STORE: products, orders, payment) --------------------------
# [PUBLIC]
NEXT_PUBLIC_SUPABASE_STORE_URL=https://PROYEK-2.supabase.co
# [SERVER][RAHASIA]
SUPABASE_STORE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_PROYEK_2
# [PUBLIC][OPSIONAL] Anon key proyek #2. MVP ini TIDAK membacanya dari browser
# (semua akses toko lewat API server), jadi boleh dikosongkan. Siapkan bila
# nanti ingin query produk langsung dari client (RLS products READ aktif).
NEXT_PUBLIC_SUPABASE_STORE_ANON_KEY=

# --- PEMBAYARAN: TRANSFER MANUAL VIA WHATSAPP ---------------------------------
# Satu-satunya metode bayar (2026-09): seluruh koordinasi pembayaran terjadi di
# WhatsApp. Buyer membuka chat dari halaman pembayaran (pesan sudah berisi kode
# order + nominal), penjual mengirim detail pembayaran (QRIS statis / rekening /
# e-wallet) di chat, lalu buyer menekan "Saya sudah transfer". Penjual mencocokkan
# mutasi dan menandai LUNAS dari dashboard.
#
# Tidak ada lagi kredensial provider / webhook / gambar QR yang disimpan
# aplikasi. Panduan: docs/manual-payment.md
#
# [SERVER] Saklar global. `false` = checkout menampilkan "pembayaran belum
# tersedia". Saklar kedua ada di /admin/settings (is_enabled).
MANUAL_PAYMENT_ENABLED=true
#
# [SERVER][OPSIONAL] CADANGAN nomor WhatsApp penjual.
# Sumber UTAMA = kolom manual_payment_settings.whatsapp_number yang diisi dari
# /admin/settings (bisa diubah tanpa deploy ulang). Env ini hanya dipakai bila
# kolom itu masih kosong — berguna untuk bootstrap sebelum login ke /admin.
# Format bebas: 081234567890 / +62 812-3456-7890 / 6281234567890.
WHATSAPP_SELLER_NUMBER=
#
# CATATAN — env yang TIDAK ada (jangan ditambahkan):
#   * STENLY_* / DEFAULT_PAYMENT_METHOD / MANUAL_PAYMENT_QR_IMAGE_URL →
#     sudah dihapus dari kode. Nilai lama di Vercel diabaikan (aman dibiarkan,
#     tapi sebaiknya dibersihkan).
#   * NEXT_PUBLIC_* untuk pembayaran → DILARANG: nomor WA dikelola server-side.

# --- TELEGRAM (notifikasi PENJUAL saja) --------------------------------------
# Buat bot via @BotFather. [SERVER][RAHASIA]
TELEGRAM_BOT_TOKEN=0000000000:CONTOH_TOKEN_BOT_TANPA_NILAI_ASLI
# Chat ID penjual (negatif untuk group, mis. -1001234567890; positif utk chat pribadi).
TELEGRAM_CHAT_ID=000000000

# --- VERCEL (otomatis tersedia di runtime; cantumkan hanya bila perlu override)
# NODE_ENV diisi oleh Vercel — tidak perlu diset manual.
