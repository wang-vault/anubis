# ============================================================================
# CONTOH KONFIGURASI — salin menjadi `.env.local` (dev) / Vercel env (prod)
# JANGAN PERNAH commit file .env asli. Nilai di bawah adalah PLACEHOLDER.
# ============================================================================
# Legenda:
#   [PUBLIC]  → diawali NEXT_PUBLIC_, ikut ke browser. TIDAK BOLEH rahasia.
#   [SERVER]  → hanya terbaca di server Vercel/Node.
#   [RAHASIA] → server-only + sensitif. Jangan pernah print / kirim ke client.
# ============================================================================

# --- Aplikasi ---------------------------------------------------------------
# [PUBLIC] URL publik situs (tanpa trailing slash). Dipakai link email & origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [PUBLIC] Nama toko yang tampil di header/title.
NEXT_PUBLIC_SITE_NAME=Toko Saya

# --- SUPABASE #1 (ACCOUNT: auth, verifikasi email, profil) ------------------
# Dapatkan: Dashboard Supabase #1 → Project Settings → Data API (or "API")
# [PUBLIC]
NEXT_PUBLIC_SUPABASE_ACCOUNT_URL=https://PROYEK-1.supabase.co
# [PUBLIC] anon/public key (aman untuk browser, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ACCOUNT_ANON_KEY=eyJhbGciOi...ANON_KEY_PROYEK_1
# [SERVER][RAHASIA] service_role — HANYA di server (bypass RLS). Jangan ke client.
SUPABASE_ACCOUNT_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_PROYEK_1

# --- SUPABASE #2 (STORE: products, orders, payment) --------------------------
# [PUBLIC]
NEXT_PUBLIC_SUPABASE_STORE_URL=https://PROYEK-2.supabase.co
# [SERVER][RAHASIA]
SUPABASE_STORE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_PROYEK_2
# [PUBLIC][OPSIONAL] Anon key proyek #2. MVP ini TIDAK membacanya dari browser
# (semua akses toko lewat API server), jadi boleh dikosongkan. Siapkan bila
# nanti ingin query produk langsung dari client (RLS products READ aktif).
NEXT_PUBLIC_SUPABASE_STORE_ANON_KEY=

# --- METODE PEMBAYARAN --------------------------------------------------------
# Toko punya 2 metode: "QRIS Otomatis" (Stenly — https://stenly.id) dan
# "Transfer Manual" (QRIS statis milikmu, mis. QR GoPay Merchant).
# Lihat docs/stenly.md dan docs/manual-payment.md.
#
# >>> MODE "MANUAL SAJA" (bawaan file ini) <<<
# Biarkan STENLY_API_KEY & STENLY_WEBHOOK_SECRET KOSONG di blok bawah.
# Efeknya otomatis, tanpa perlu ubah kode:
#   - "QRIS Otomatis" tampil ber-badge "Ongoing" dan tidak bisa dipilih,
#   - permintaan yang memaksa paymentMethod=STENLY ditolak,
#   - webhook Stenly ditolak (signature tak bisa diverifikasi).
# Yang WAJIB kamu lakukan agar checkout hidup: upload gambar QR statis di
# /admin/settings. Tanpa QR itu, metode manual dianggap belum siap dan buyer
# melihat "Pembayaran belum tersedia".
#
# [SERVER] Metode terpilih default di halaman checkout: MANUAL | STENLY
# Salah ketik TIDAK menjatuhkan situs — nilai tak dikenal jatuh ke MANUAL.
# Nilai lama "YOBASEPAY" masih diterima dan otomatis dibaca sebagai STENLY.
DEFAULT_PAYMENT_METHOD=MANUAL

# --- PEMBAYARAN MANUAL (QRIS statis penjual) ----------------------------------
# Gambar QR di-upload dari /admin/settings (disimpan di Supabase #2), jadi
# biasanya TIDAK perlu env apa pun di blok ini.
# [SERVER] Saklar global metode manual (saklar kedua ada di /admin/settings).
MANUAL_PAYMENT_ENABLED=true
# [SERVER][OPSIONAL] Bila kamu lebih suka host gambar QR sendiri (https).
# Bila diisi, URL ini yang dipakai buyer (mengalahkan gambar hasil upload).
MANUAL_PAYMENT_QR_IMAGE_URL=

# --- STENLY (payment gateway QRIS otomatis) ----------------------------------
# OPSIONAL: kosongkan kedua nilai di bawah bila QRIS otomatis belum aktif —
# metodenya otomatis ber-badge "Ongoing" & webhook ditolak, toko tetap jalan
# dengan pembayaran manual.
# Daftar & buat "project" di https://stenly.id → Dashboard → Projects.
# Panduan lengkap (termasuk cara pasang Callback URL): docs/stenly.md
#
# [SERVER][RAHASIA] Secret Key project. Produksi `sk_live_…`, sandbox `sk_test_…`.
# Dikirim sebagai header `x-api-key`. JANGAN pernah dipakai di browser dan
# JANGAN diberi awalan NEXT_PUBLIC_.
STENLY_API_KEY=
# [SERVER][RAHASIA] Webhook Secret project (`whsec_…`). Dipakai memverifikasi
# HMAC-SHA256 pada header `X-Stenly-Signature` atas RAW body webhook.
STENLY_WEBHOOK_SECRET=
# [SERVER] Base URL REST API Stenly (tanpa trailing slash).
# Endpoint yang dipakai: POST {BASE}/api/v1/charge dan GET {BASE}/api/v1/status/:order_id
STENLY_BASE_URL=https://stenly.id
# [SERVER][OPSIONAL] Masa aktif QRIS dalam menit (dikirim sebagai `expiry_minutes`).
# Default provider 15 menit. Rentang yang diterima aplikasi: 1..1440.
STENLY_EXPIRY_MINUTES=15
#
# CATATAN — env yang TIDAK ada (jangan ditambahkan):
#   * STENLY_WEBHOOK_URL   → tidak perlu; URL callback dihitung dari
#     NEXT_PUBLIC_SITE_URL + /api/webhooks/stenly dan ditampilkan siap-salin di
#     /admin/payments. Daftarkan URL itu di dashboard Stenly.
#   * STENLY_AMOUNT_TOLERANCE → QRIS Stenly menagih nominal PERSIS, jadi
#     toleransinya 0 (hard-coded). Kode unik hanya dipakai metode manual.
#   * NEXT_PUBLIC_STENLY_*  → DILARANG. Semua kredensial Stenly server-only.

# --- TELEGRAM (notifikasi PENJUAL saja) --------------------------------------
# Buat bot via @BotFather. [SERVER][RAHASIA]
TELEGRAM_BOT_TOKEN=0000000000:CONTOH_TOKEN_BOT_TANPA_NILAI_ASLI
# Chat ID penjual (negatif untuk group, mis. -1001234567890; positif utk chat pribadi).
TELEGRAM_CHAT_ID=000000000

# --- VERCEL (otomatis tersedia di runtime; cantumkan hanya bila perlu override)
# NODE_ENV diisi oleh Vercel — tidak perlu diset manual.
